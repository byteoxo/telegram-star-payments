# Get this token from @BotFather: https://t.me/BotFather
BOT_TOKEN=123456:ABC-DEF...

# Required only for fiat (USD/EUR/...) invoices. Get it in BotFather:
# My Bots -> <bot> -> Payments -> pick a provider (Stripe / Smart Glocal / ...).
# BotFather gives you both a TEST and a LIVE token; start with the TEST one.
# Stars (XTR) invoices DO NOT need this.
PROVIDER_TOKEN=

# Optional: numeric chat id of an admin who should receive payment notifications.
ADMIN_CHAT_ID=
